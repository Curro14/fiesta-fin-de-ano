{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fiesta-fin-de-ano",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fiesta-fin-de-ano",
      "database_id": "ce6f0d52-b59c-48e8-9e22-c623f3ea11a5",
      "migrations_dir": "migrations"
    }
  ]
}
