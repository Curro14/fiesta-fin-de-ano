{
  "name": "fiesta-fin-de-ano",
  "version": "1.0.0",
  "description": "Inscripción, bebidas, pagos por Bizum y entradas QR para la fiesta de fin de año",
  "main": "src/worker.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
